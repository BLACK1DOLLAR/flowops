# Copy to server/.env (local runs) or export before `docker compose up`.

# Required when the server listens beyond this machine (HOST other than 127.0.0.1).
# The editor asks for it once and remembers it in the browser.
API_TOKEN=

# Or let anyone in with no token (the Code node is then disabled):
# PUBLIC_ACCESS=true

# Required in production: key used to encrypt stored credentials. Changing it
# makes existing credentials unreadable.
ENCRYPTION_KEY=

# HOST=127.0.0.1
# PORT=5175
# PUBLIC_URL=http://localhost:5175        # used to build Wait-node resume links
# CORS_ORIGIN=https://flows.example.com   # only if the editor is on another origin
# DATABASE_URL=postgres://user:pass@localhost:5432/flowops
# REDIS_URL=redis://localhost:6379
